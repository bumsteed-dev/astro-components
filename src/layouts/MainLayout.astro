---
import Analytics from "@vercel/analytics/astro";
import SEO from "../components/SEO.astro";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Astro Components",
	url: "https://ui.bumsteed.dev",
	description:
		"A curated collection of beautiful, copy-paste components for Astro. Built by and for the community.",
	inLanguage: "en",
	publisher: {
		"@type": "Person",
		name: "Jesús Cedeño Vélez",
		url: "https://github.com/bumsteed-dev",
	},
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<SEO {...Astro.props} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<Analytics />
	</head>
	<body>
		<slot />
	</body>
</html>
